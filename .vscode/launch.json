{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Provider",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 2345,
            "host": "127.0.0.1",
            "preLaunchTask": "Start Headless Debugger"
        },
        {
            "name": "Debug Tests (Current File)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "env": {
                "TF_ACC": "1",
                "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
            }
        },
        {
            "name": "Debug Provider Acceptance Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/provider",
            "env": {
                "TF_ACC": "1",
                "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
            }
        }
    ]
}